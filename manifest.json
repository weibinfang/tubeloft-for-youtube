{
  "manifest_version": 3,
  "name": "VideoDeck for YouTube",
  "short_name": "VideoDeck",
  "version": "1.0.0",
  "description": "A modern layer of upgrades for YouTube: tabbed video details with comments in the sidebar, playback speed control, screenshots, loop and picture-in-picture. Uses Tabview-Youtube (MIT) as its layout engine.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["contextMenus"],
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "exclude_matches": ["*://*.youtube.com/live_chat*"],
      "exclude_globs": [
        "*.txt*", "*.png*", "*.jpg*", "*.jpeg*", "*.gif*",
        "*.xml*", "*.svg*", "*.manifest*", "*.log*", "*.ini*"
      ],
      "js": ["tabview-main.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "exclude_matches": ["*://*.youtube.com/live_chat*"],
      "exclude_globs": [
        "*.txt*", "*.png*", "*.jpg*", "*.jpeg*", "*.gif*",
        "*.xml*", "*.svg*", "*.manifest*", "*.log*", "*.ini*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
